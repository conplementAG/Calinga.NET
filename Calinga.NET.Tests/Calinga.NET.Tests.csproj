<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>8.0</LangVersion>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="RichardSzalay.MockHttp" Version="7.0.0" />
    <PackageReference Include="Reqnroll" Version="3.3.4" />
    <PackageReference Include="Reqnroll.MsTest" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <FeatureFiles Include="..\Specs\**\*.feature" />
  </ItemGroup>
  <Target Name="IncludeCucumberMessagesSpecs" BeforeTargets="BeforeBuild" Condition="$(DesignTimeBuild) != 'true' OR '$(BuildingProject)' == 'true'">
    <Copy SourceFiles="@(FeatureFiles)" DestinationFolder="Specs/%(RecursiveDir)" />
    <ItemGroup>
      <None Include="Specs/**/*.feature" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Calinga.NET\Calinga.NET.csproj" />
  </ItemGroup>


</Project>
